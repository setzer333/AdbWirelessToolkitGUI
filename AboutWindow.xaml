<Window x:Class="AdbWirelessToolkitGUI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdbWirelessToolkitGUI"
Title="{DynamicResource AboutTitle}"
        Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Icon="pack://application:,,,/assets/Android-Logo-2008.ico"
        mc:Ignorable="d">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackgroundColor" Color="#252526"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="AccentColor" Color="#0078D4"/>
        <SolidColorBrush x:Key="ButtonBackgroundColor" Color="#3A3A3C"/>
        <SolidColorBrush x:Key="ButtonHoverColor" Color="#107C10"/>
        <SolidColorBrush x:Key="ButtonPressedColor" Color="#005A9E"/>

        <Style x:Key="AboutButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3A3A3C"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6"
                                Padding="12,0,12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#107C10"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#252526" Margin="10" CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25,20,25,20">
<!-- Logo -->
                <Image Source="pack://application:,,,/assets/Android-Logo-2008.png" 
                       Width="80" Height="80" 
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,10"/>

                <!-- Title and Version -->
                <TextBlock Text="{DynamicResource AppTitle}" 
                           FontSize="22" 
                           FontWeight="SemiBold" 
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,5"/>
                
                <TextBlock Text="{DynamicResource AboutVersion}" 
                           FontSize="14" 
                           Foreground="#707070"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <!-- Description -->
                <TextBlock Text="{DynamicResource AboutDescription}" 
                           FontSize="12" 
                           Foreground="#CCCCCC"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"
                           LineHeight="18"/>

                <Separator Background="#444444" Margin="0,0,0,15"/>

                <!-- Author -->
                <TextBlock Text="{DynamicResource AboutAuthor}" 
                           FontSize="13" 
                           FontWeight="Medium"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,0,5,0"/>

                <!-- Contact -->
                <TextBlock Text="{DynamicResource AboutContact}" 
                           FontSize="11" 
                           Foreground="#888888"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <!-- License -->
                <TextBlock Text="{DynamicResource AboutLicense}" 
                           FontSize="11" 
                           Foreground="#707070"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Close Button -->
                <Button Content="{DynamicResource AboutClose}" 
                        Style="{StaticResource AboutButtonStyle}"
                        HorizontalAlignment="Center"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>