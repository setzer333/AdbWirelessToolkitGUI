<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\Android-Logo-2008.ico</ApplicationIcon>
    <TargetPlatformVersion>10.0.26100.0</TargetPlatformVersion>
    <PackageIcon>Android-Logo-2008.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NeutralLanguage>es-419</NeutralLanguage>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <PackageReleaseNotes>Version inicial</PackageReleaseNotes>
    <PackageTags>adb, usb debug, android, wireless debug, sideload, apk, pair device</PackageTags>
    <Copyright>Setzer333</Copyright>
    <Company>Setzer333</Company>
    <Authors>Setzer333</Authors>
    <Title>AdbWirelessToolkitGUI</Title>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageLicenseFile>Combined-License_2.txt</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Incluye TODOS los archivos del SDK PlatformTools (binarios, DLLs, configs) -->
    <Content Include="PlatformTools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\Android-Logo-2008.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include RUNTIME assets (VC++ redistributables and .NET runtime URLs) -->
    <Content Include="assets\RUNTIME\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="assets\Android-Logo-2008.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="assets\LICENSE-GPL3.rtf">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="assets\LICENSE-MIT.rtf">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="Combined-License_2.txt">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- Include PlatformTools and RUNTIME assets in publish output -->
  <Target Name="CopyPlatformToolsToPublish" AfterTargets="Publish" BeforeTargets="BuildInstaller" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <PlatformToolsFiles Include="PlatformTools\**\*" />
      <AssetsFiles Include="Assets\**\*" />
      <RuntimeFiles Include="assets\RUNTIME\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PlatformToolsFiles)" DestinationFolder="$(PublishDir)PlatformTools\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AssetsFiles)" DestinationFolder="$(PublishDir)Assets\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeFiles)" DestinationFolder="$(PublishDir)RUNTIME\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Post-build event: Build Inno Setup installer on Release configuration -->
  <Target Name="BuildInstaller" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ISCCPath>"C:\Program Files\Inno Setup 7\ISCC.exe"</ISCCPath>
      <IssPath>$(ProjectDir)Installer\installer.iss</IssPath>
    </PropertyGroup>
    <Exec Command="$(ISCCPath) $(IssPath)" WorkingDirectory="$(ProjectDir)Installer" />
  </Target>

</Project>