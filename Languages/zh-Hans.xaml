<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- 主窗口 -->
    <system:String x:Key="AppTitle">ADB Wireless Toolkit</system:String>
    <system:String x:Key="WirelessConnection">无线连接</system:String>
    <system:String x:Key="ScanNetwork">🌐 扫描本地网络 (IP)</system:String>
    <system:String x:Key="ScanMdns">🔍 mDNS 扫描 (原生)</system:String>
    <system:String x:Key="PairDevice">📱 配对设备</system:String>
    <system:String x:Key="LoadProfile">▼</system:String>
    <system:String x:Key="LoadProfileTooltip">已保存的配置文件 (最多10个)</system:String>
    <system:String x:Key="HostPortLabel">HOST:PORT</system:String>
    <system:String x:Key="HostPortTooltip">示例: 192.168.1.100:5555</system:String>
    <system:String x:Key="PairCodeLabel">配对码</system:String>
    <system:String x:Key="PairCodeTooltip">设备上显示的6位数字代码</system:String>
    <system:String x:Key="DevicesConnected">📋 已连接设备</system:String>
    <system:String x:Key="RestartServer">🔄 重启 ADB 服务器</system:String>
    
    <system:String x:Key="DeviceManagement">设备管理</system:String>
    <system:String x:Key="InstallApk">📲 安装 APK</system:String>
    <system:String x:Key="SideloadApk">📦 Sideload APK (USB)</system:String>
    <system:String x:Key="TransferFile">📄 传输文件</system:String>
    <system:String x:Key="RebootDevice">🔄 重启设备 (系统)</system:String>
    
    <system:String x:Key="BackupTools">备份工具</system:String>
    <system:String x:Key="OpenCmd">💻 打开外部 CMD</system:String>

    <!-- 控制台和终端 -->
    <system:String x:Key="LogConsoleTitle">日志控制台</system:String>
    <system:String x:Key="ManualTerminal">手动终端 (直接 ADB 命令)</system:String>
    <system:String x:Key="AdbPrefix">adb </system:String>
    <system:String x:Key="RunCommand">执行命令</system:String>

    <!-- 进度 -->
    <system:String x:Key="SpeedLabel">0 B/s</system:String>
    <system:String x:Key="ProgressLabel">0%</system:String>

    <!-- 对话框和消息 -->
    <system:String x:Key="ErrorEmptyCommand">[MANUAL] 命令为空。请输入 ADB 命令。</system:String>
    <system:String x:Key="ErrorHostPortRequired">错误: 必须输入 HOST:PORT (例如: 192.168.1.100:5555)</system:String>
    <system:String x:Key="ErrorPairCodeRequired">错误: 必须输入配对码 (6位数字)</system:String>
    <system:String x:Key="ErrorPairCodeFormat">错误: 配对码必须是6位数字</system:String>
    <system:String x:Key="ScanningNetwork">=== 正在扫描本地网络 (Ping .1-.99) ===</system:String>
    <system:String x:Key="ScanningMdns">=== 原生 mDNS 扫描 (adb mdns services) ===</system:String>
    <system:String x:Key="PairingDevice">=== 正在配对设备: {0} ===</system:String>
    <system:String x:Key="PairingCompleted">=== 配对完成 ===</system:String>
    <system:String x:Key="GettingDevices">=== 正在获取设备列表 ===</system:String>
    <system:String x:Key="DevicesObtained">=== 已获取设备列表 ===</system:String>
    <system:String x:Key="RestartingServer">=== 正在重启 ADB 服务器 ===</system:String>
    <system:String x:Key="StoppingServer">--- 步骤1: 停止服务器 (adb kill-server) ---</system:String>
    <system:String x:Key="Waiting">--- 等待 1 秒 ---</system:String>
    <system:String x:Key="StartingServer">--- 步骤2: 启动服务器 (adb start-server) ---</system:String>
    <system:String x:Key="ServerRestarted">=== ADB 服务器重启成功 ===</system:String>
    <system:String x:Key="InstallingApk">=== 正在安装 APK: {0} ===</system:String>
    <system:String x:Key="InstallCompleted">=== 安装完成 ===</system:String>
    <system:String x:Key="SideloadStarting">=== 开始 Sideload APK: {0} ===</system:String>
    <system:String x:Key="SideloadWarning">⚠ 请确保设备处于 'Recovery' → 'Apply update from ADB' 模式</system:String>
    <system:String x:Key="SideloadCompleted">=== Sideload 完成 ===</system:String>
    <system:String x:Key="TransferStarting">=== 正在传输: {0} -> {1} ===</system:String>
    <system:String x:Key="TransferCompleted">=== 传输完成 ===</system:String>
    <system:String x:Key="Rebooting">=== 正在重启设备 (系统) ===</system:String>
    <system:String x:Key="RebootInitiated">=== 重启已开始 ===</system:String>
    <system:String x:Key="ManualCommand">[MANUAL] adb {0}</system:String>
    <system:String x:Key="ManualCompleted">[MANUAL] 命令完成。</system:String>
    <system:String x:Key="OperationCancelled">=== 操作已取消 ===</system:String>
    <system:String x:Key="ErrorPrefix">错误: {0}</system:String>
    <system:String x:Key="CmdOpened">[CMD] 外部控制台已打开: {0}</system:String>
    <system:String x:Key="CmdError">[CMD] 打开控制台失败: {0}</system:String>
    <system:String x:Key="CmdNotFound">[CMD] 错误: 未找到 PlatformTools: {0}</system:String>
    <system:String x:Key="NoProfiles">[配置文件] 没有保存的配置文件。配对设备并保存配置文件。</system:String>
    <system:String x:Key="ProfileLoaded">[配置文件] 已加载: {0}</system:String>
    <system:String x:Key="ProfileSaved">[配置文件] 已保存: {0}</system:String>
    <system:String x:Key="AllProfilesCleared">[配置文件] 已清除所有配置文件</system:String>
    <system:String x:Key="ScanCompleted">=== 扫描完成 ===</system:String>
    <system:String x:Key="MdnsScanCompleted">=== mDNS 扫描完成 ===</system:String>

    <!-- 保存配置文件窗口 -->
    <system:String x:Key="SaveProfileTitle">保存配对配置文件</system:String>
    <system:String x:Key="SaveProfileMessage">配对成功。是否保存此配置文件以供将来使用？</system:String>
    <system:String x:Key="SaveProfileDevice">设备: {0}</system:String>
    <system:String x:Key="SaveProfileLimitWarning">⚠ 已达到10个配置文件的限制。请选择一个要覆盖的配置文件:</system:String>
    <system:String x:Key="SaveProfileNameLabel">配置文件名称 (可选):</system:String>
    <system:String x:Key="SaveProfileNameTooltip">留空则使用 HOST:PORT 作为名称</system:String>
    <system:String x:Key="SaveProfileOverwriteBtn">覆盖</system:String>
    <system:String x:Key="SaveProfileSaveBtn">保存</system:String>
    <system:String x:Key="SaveProfileCancelBtn">不保存</system:String>

    <!-- 配置文件菜单 -->
    <system:String x:Key="ClearAllProfiles">🗑 清除所有配置文件</system:String>
    <system:String x:Key="ConfirmClearProfiles">删除所有已保存的配置文件？</system:String>
    <system:String x:Key="ConfirmTitle">确认</system:String>

    <!-- 关于窗口 -->
    <system:String x:Key="AboutTitle">关于 ADB Wireless Toolkit</system:String>
    <system:String x:Key="AboutVersion">版本 1.0.0</system:String>
    <system:String x:Key="AboutDescription">用于通过 ADB 无线管理 Android 设备的现代图形界面工具。\n原生 WPF Windows 11 风格界面，包含网络扫描、配对、Sideload 和手动终端。</system:String>
    <system:String x:Key="AboutAuthor">开发者: sqnym</system:String>
    <system:String x:Key="AboutContact">联系方式: sqnyps3@gmail.com (仅接受建议和Bug报告)</system:String>
    <system:String x:Key="AboutLicense">双重许可证: MIT / GNU GPL v3</system:String>
    <system:String x:Key="AboutClose">关闭</system:String>

    <!-- 设置 -->
    <system:String x:Key="Language">语言</system:String>
    <system:String x:Key="Language_es_419">Español (Neutro)</system:String>
    <system:String x:Key="Language_en_US">English (US)</system:String>
    <system:String x:Key="Language_ru">Русский</system:String>
    <system:String x:Key="Language_pt_BR">Português (Brasil)</system:String>
    <system:String x:Key="Language_ja">日本語</system:String>
    <system:String x:Key="Language_zh_Hans">中文 (简体)</system:String>

</ResourceDictionary>